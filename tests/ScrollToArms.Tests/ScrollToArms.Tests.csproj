<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the walk along the hotbar: where a notch of the wheel puts the cursor. src/HotbarWalk.cs
       has no Unity, BepInEx or game reference, so it builds here on its own.
       Run with: dotnet test tests/ScrollToArms.Tests
       Not referenced by ScrollToArms.csproj, so the plugin build never builds it. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>ScrollToArms.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/HotbarWalk.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
