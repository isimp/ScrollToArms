<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ScrollToArms</AssemblyName>
    <RootNamespace>ScrollToArms</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.2.3</Version>
    <Authors>isimp</Authors>
    <Product>ScrollToArms</Product>
    <Description>Pick the weapon or tool in your hand with the mouse wheel, while the game still decides when it can be changed.</Description>
    <Copyright>Copyright (c) 2026 isimp</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <Import Project="BuildChecks.props" />
  <Import Project="GameReferences.props" />

  <!-- The tests are projects of their own (see tests/), and the in-game self-test a plugin of its
       own (see selftest/). A release takes ScrollToArms.dll alone. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="selftest/**" />
  </ItemGroup>

  <Target Name="DeployToProfile" AfterTargets="Build"
          Condition="'$(LibsDir)' == '' And Exists('$(BepInExDir)\plugins')">
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" ContinueOnError="true" />
    <Message Importance="high" Text="ScrollToArms -> $(DeployDir)" />
  </Target>

</Project>
