is_global = true

# The .NET code analysis rules ScrollToArms turns off, each for what it misreads here. Every other
# rule runs and fails the build (BuildChecks.props).

# Unity's objects compare equal to null once destroyed, which flow analysis does not know: a
# null check on one that looks set is how a destroyed one is skipped, not dead code.
dotnet_diagnostic.CA1508.severity = none

# Unity calls its messages (Awake, Update, OnDestroy) on the instance, by name; they cannot be static.
dotnet_diagnostic.CA1822.severity = none

# A BepInEx plugin's id is a dotted name ("isimp.ScrollToArms"), not a GUID, whatever its parameter
# is called, and BepInEx names it GUID.
dotnet_diagnostic.CA2243.severity = none
dotnet_diagnostic.CA1720.severity = none

# A failure in ScrollToArms must never take the game or another mod down with it: the game's
# members it reaches by reflection may be gone or changed after an update, and such a failure is
# caught, told in the log and left alone, whatever the exception. FailureStandardTests holds every
# catch to that.
dotnet_diagnostic.CA1031.severity = none
